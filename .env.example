DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CORS_ORIGINS=*

# Database (shared by the auth service; future app data can live here too)
POSTGRES_DB=partis
POSTGRES_USER=partis
POSTGRES_PASSWORD=change-me

# Auth service - secret used to sign local JWTs, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-too

# First app_admin account (there's no public sign-up - this is how you get in
# the first time, to create organizations from the admin panel). Log in with
# no organization field.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-too
