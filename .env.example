DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
CORS_ORIGINS=*

# Database (shared by the auth service; future app data can live here too)
POSTGRES_DB=partis
POSTGRES_USER=partis
POSTGRES_PASSWORD=change-me

# Auth service - secret used to sign local JWTs, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-too
